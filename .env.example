# Production settings. Copy to .env, fill in, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# docker compose reads .env automatically. NEVER commit .env (it's in .gitignore).
# The API refuses to start in Production with any of the public development defaults.

# Public host name; Caddy gets a Let's Encrypt certificate for it (use "localhost" to test locally).
DOMAIN=hotels.example.com

POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Token signing key, at least 32 characters:   openssl rand -base64 48
JWT_KEY=

# Encryption of guest personal data at rest. Each key is 32 random bytes, base64:   openssl rand -base64 32
# Keep backups of these keys: without them encrypted data can't be read.
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEY=
# Separate key for searchable email hashes. Don't rotate it (lookups depend on it).
BLIND_INDEX_KEY=

# Real SMTP relay for guest emails (SendGrid, Mailgun, Office 365, ...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
