{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=hotel;Username=hotel;Password=hotel;GSS Encryption Mode=Disable"
  },
  "Jwt": {
    "Issuer": "HotelManagement",
    "Audience": "HotelManagement.Api",
    "Key": "",
    "ExpiryMinutes": 15
  },
  "RefreshTokens": {
    "RefreshTokenDays": 14
  },
  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Encryption": {
    "KeyId": "k1",
    "Key": "",
    "BlindIndexKey": "",
    "RetiredKeys": {}
  },
  "Https": {
    "BehindProxy": false,
    "RequireHttps": true,
    "HstsMaxAgeDays": 365
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedSampleData": false
  },
  "Email": {
    "Host": "",
    "Port": 25,
    "Security": "Auto",
    "FromAddress": "no-reply@hotel-management.local",
    "FromName": "Hotel Management"
  },
  "PublicBooking": {
    "CancellationCutoffHours": 24
  },
  "RateLimiting": {
    "PublicPerMinute": 60,
    "PublicWritePerMinute": 10,
    "AuthPerMinute": 10
  }
}
